{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/basejb/isms-p-audit-skill/references/capability.schema.json",
  "title": "ISMS-P Capability Schema",
  "description": "isms-p-audit Skill v0.4 단계 1 — Capability 모델. 스택 무관 (stack-agnostic) 보안 능력을 ISMS-P 통제와 controls.json 시그널 family 사이의 중간 계층으로 정의한다. 5단 흐름: control → required_capabilities → aspects → signal_families → 실제 시그널.",
  "type": "object",
  "required": ["schema_version", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "description": "capabilities.json 스키마 버전."
    },
    "isms_p_version": {
      "type": "string",
      "description": "참조한 KISA ISMS-P 안내서 버전 (e.g. '2023.11')."
    },
    "last_verified": {
      "type": "string",
      "format": "date",
      "description": "최종 검증 일자 (YYYY-MM-DD)."
    },
    "description": {
      "type": "string",
      "description": "Capability 카탈로그 전체 설명."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" },
      "description": "Capability 배열."
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "required": ["id", "name", "category", "description", "verification_aspects"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Capability 식별자 (snake_case)."
        },
        "name": {
          "type": "string",
          "description": "Capability 이름."
        },
        "category": {
          "type": "string",
          "enum": [
            "identity",
            "access",
            "application",
            "network",
            "crypto",
            "logging",
            "operations",
            "data-protection",
            "compliance"
          ],
          "description": "Capability 카테고리."
        },
        "description": {
          "type": "string",
          "description": "Capability 설명."
        },
        "verification_aspects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verification_aspect" },
          "description": "Capability 충족을 검증하는 측면(aspect) 배열."
        },
        "isms_p_relevance": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[1-3]\\.[0-9]+(\\.[0-9]+)?$"
          },
          "description": "이 Capability 가 관련되는 ISMS-P 통제 ID 배열."
        }
      }
    },
    "verification_aspect": {
      "type": "object",
      "required": ["id", "description", "satisfied_by_signal_families"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Aspect 식별자 (snake_case, capability 내 유니크)."
        },
        "description": {
          "type": "string",
          "description": "Aspect 설명."
        },
        "satisfied_by_signal_families": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "이 aspect 를 충족시키는 시그널 family 명 배열 (controls.json / stacks/official/*.json 의 family 명과 일치)."
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "이 aspect 가 capability 충족에 필수인지 여부."
        },
        "applicable_to": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["frontend", "backend", "fullstack", "infra", "mobile", "all"]
          },
          "default": ["all"],
          "description": "v0.5.0-B 부터 추가. 이 aspect 가 평가 가능한 레포 역할. 'all' 은 모든 역할에서 평가 가능. 옵션 필드 — 미명시 시 [\"all\"] 로 처리."
        },
        "evidence_hint": {
          "type": "string",
          "description": "시그널 외 수동 증적 안내."
        }
      }
    }
  }
}
